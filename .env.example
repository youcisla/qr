# ---------------------------------------------------------------------------
# Yopem QR environment variables
# ---------------------------------------------------------------------------

# Required: PostgreSQL connection string (Supabase pooled URL works; prepare is disabled).
DATABASE_URL=

# Optional: OpenAuth issuer used for sign-in. Defaults to https://auth.yopem.com,
# or to the self-hosted issuer shipped in src/lib/server/auth-issuer.
AUTH_ISSUER=

# Optional: secret used to salt the hashed IP/visitor identifiers stored for
# scan analytics. Set a long random value in production (falls back to a
# DATABASE_URL-derived value when omitted).
SCAN_SALT=

# Optional: HMAC secret for the password-protected QR unlock cookie. Set a long
# random value in production.
UNLOCK_SECRET=

# Optional: SEO/site metadata (public, inlined at build time).
PUBLIC_SITE_TITLE=Yopem QR
PUBLIC_SITE_DESCRIPTION=Design, track and scan QR codes
PUBLIC_SITE_NAME=Yopem
